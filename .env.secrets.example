# Mokuro Library - Secrets Configuration
# This file is an example. DO NOT use these values in production!
#
# To generate secure secrets:
# 1. Run: ./scripts/generate-secrets.sh .env.secrets
# 2. OR manually generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then use this file with Docker Compose:
#   docker-compose --env-file .env.secrets up -d

# JWT Secret (REQUIRED) - Used for signing authentication tokens
# Must be a secure random string (at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_32_CHARS_MIN

# Cookie Secret (REQUIRED) - Used for signing cookies
# Must be a secure random string (at least 32 characters)
COOKIE_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_32_CHARS_MIN
